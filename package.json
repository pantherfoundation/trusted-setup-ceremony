{
  "name": "trusted-setup",
  "version": "1.0.0",
  "description": "Trusted setup ceremony for ZK circuit",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "tsc && tsc-alias",
    "contribute": "pnpm build && node dist/contribute.js",
    "verify": "pnpm build && node dist/verify.js",
    "finalize": "pnpm build && node dist/finalize.js",
    "clean:zkey": "rm -rf ./contributions/**/*.zkey"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "aws-sdk": "^2.1692.0",
    "dotenv": "^16.4.7",
    "fs-extra": "^11.1.1",
    "readline-sync": "^1.4.10",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^18.15.11",
    "@types/readline-sync": "^1.4.4",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.0.4"
  }
}
